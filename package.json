{
  "name": "winnotch",
  "version": "7.1.13",
  "description": "WinNotch — Dynamic Island for Windows",
  "main": "src/main.js",
  "scripts": {
    "prestart": "node scripts/build-helper.js",
    "start": "electron .",
    "test": "node --test test/lid-motion.test.js test/media-title.test.js test/say-format.test.js test/agent-scan.test.js test/hook-install.test.js test/hook-relay.test.js test/main.test.js test/preload.test.js test/orb-state.test.js test/session-prompt.test.js test/vscode-send.test.js",
    "prebuild": "npm version patch --no-git-tag-version && node scripts/build-helper.js",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.winnotch.app",
    "productName": "WinNotch",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "files": [
      "src/**/*",
      "!src/helper/*.cs",
      "package.json"
    ],
    "asarUnpack": [
      "src/helper/*.exe"
    ]
  },
  "dependencies": {
    "@ybouane/liquidglass": "^1.0.3",
    "electron-store": "^11.0.2",
    "thinking-orbs": "^0.3.2",
    "yt-search": "^2.13.1"
  }
}
